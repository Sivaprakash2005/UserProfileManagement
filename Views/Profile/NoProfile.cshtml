@{
    ViewData["Title"] = "No Profile Found";
}

<div class="container my-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card profile-card mx-auto shadow-lg text-center">

        <div class="card-body p-5">

            <div class="mb-4">
                <i class="bi bi-person-x-fill text-warning display-1"></i>
            </div>

            <h2 class="h3 text-danger fw-bold mb-3">
                No Profile Found
            </h2>

            <p class="text-muted mb-4">
                No user profile is currently available in the database.
            </p>

            <a asp-controller="Profile"
               asp-action="Index"
               class="btn btn-primary px-4">
                <i class="bi bi-arrow-clockwise me-2"></i>Refresh Page
            </a>

        </div>

    </div>

</div>