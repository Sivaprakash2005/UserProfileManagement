@model UserProfileManagement.Models.UserProfile

@{
    ViewData["Title"] = "User Profile";
    var avatarInitial = string.IsNullOrWhiteSpace(Model?.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper();
    var profiles = ViewBag.Profiles as List<UserProfileManagement.Models.UserProfile> ?? new List<UserProfileManagement.Models.UserProfile>();
}

<div class="container my-4">

    <!-- Profile Switcher & Add Profile Header Bar -->
    @if (profiles.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4 p-3 bg-white rounded-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-bold text-dark me-2">
                        <i class="bi bi-people-fill text-primary me-1"></i>Select Profile:
                    </span>
                    <div class="btn-group flex-wrap" role="group">
                        @foreach (var p in profiles)
                        {
                            <a asp-controller="Profile"
                               asp-action="Index"
                               asp-route-id="@p.UserId"
                               class="btn btn-sm @(p.UserId == Model?.UserId ? "btn-primary font-weight-bold shadow-sm" : "btn-outline-primary")">
                                <i class="bi bi-person-fill me-1"></i>@p.FullName
                            </a>
                        }
                    </div>
                </div>
                <div>
                    <a asp-controller="Profile" asp-action="Create" class="btn btn-sm btn-success px-3 shadow-sm">
                        <i class="bi bi-person-plus-fill me-1"></i>Add New Profile
                    </a>
                </div>
            </div>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card profile-card mx-auto shadow-lg">

        <!-- Professional Header Banner -->
        <div class="profile-card-header text-white text-center py-4">
            <div class="profile-avatar mb-2">
                @avatarInitial
            </div>
            <h2 class="h3 mb-1 text-white fw-bold">@Model?.FullName</h2>
            <p class="mb-0 text-white-50 small">User Profile Management System</p>
        </div>

        <div class="card-body p-4">

            <div class="profile-details-list">

                <!-- Email -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-envelope-fill text-primary me-2"></i>Email Address
                    </div>
                    <div class="col-sm-8 fw-semibold text-dark">
                        @Model?.Email
                    </div>
                </div>

                <!-- Phone -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-telephone-fill text-primary me-2"></i>Phone Number
                    </div>
                    <div class="col-sm-8 fw-semibold text-dark">
                        @(string.IsNullOrWhiteSpace(Model?.PhoneNumber) ? "Not Available" : Model.PhoneNumber)
                    </div>
                </div>

                <!-- Date of Birth -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-calendar-event-fill text-primary me-2"></i>Date of Birth
                    </div>
                    <div class="col-sm-8 fw-semibold text-dark">
                        @(Model?.DateOfBirth.HasValue == true ? Model.DateOfBirth.Value.ToString("dd-MM-yyyy") : "Not Available")
                    </div>
                </div>

                <!-- Address -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-geo-alt-fill text-primary me-2"></i>Address
                    </div>
                    <div class="col-sm-8 fw-semibold text-dark">
                        @(string.IsNullOrWhiteSpace(Model?.Address) ? "Not Available" : Model.Address)
                    </div>
                </div>

                <!-- Created Date -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-clock-fill text-primary me-2"></i>Created Date
                    </div>
                    <div class="col-sm-8 text-secondary">
                        @Model?.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                    </div>
                </div>

                <!-- Last Updated Date -->
                <div class="row profile-row py-3 align-items-center">
                    <div class="col-sm-4 text-muted font-weight-bold">
                        <i class="bi bi-arrow-repeat text-primary me-2"></i>Last Updated Date
                    </div>
                    <div class="col-sm-8 text-secondary">
                        @Model?.UpdatedAt.ToString("dd-MM-yyyy HH:mm")
                    </div>
                </div>

            </div>

            <!-- Action Button -->
            <div class="text-center mt-4 pt-2">
                <a asp-controller="Profile"
                   asp-action="Edit"
                   asp-route-id="@Model?.UserId"
                   class="btn btn-primary btn-lg px-4 profile-edit-btn">
                    <i class="bi bi-pencil-square me-2"></i>Edit Profile
                </a>
            </div>

        </div>

    </div>

</div>