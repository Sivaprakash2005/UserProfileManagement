@model UserProfileManagement.Models.UserProfile

@{
    ViewData["Title"] = "Add New Profile";
}

<div class="container my-5">

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card edit-profile-card mx-auto shadow-lg">

        <div class="edit-card-header text-center py-4 bg-primary text-white">
            <h2 class="h3 mb-0 fw-bold text-white">
                <i class="bi bi-person-plus-fill me-2"></i>Add New User Profile
            </h2>
            <p class="mb-0 text-white-50 small mt-1">Enter details to create a new user profile</p>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Profile"
                  asp-action="Create"
                  method="post"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-4"
                     role="alert">
                </div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-bold">
                        Full Name <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person-fill text-muted"></i></span>
                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter full name" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-bold">
                        Email Address <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-muted"></i></span>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="example@gmail.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Phone Number -->
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label fw-bold">
                        Phone Number <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone-fill text-muted"></i></span>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               maxlength="10"
                               placeholder="9876543210" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Date Of Birth -->
                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="form-label fw-bold">
                        Date of Birth
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event-fill text-muted"></i></span>
                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control" />
                    </div>
                    <span asp-validation-for="DateOfBirth" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Address -->
                <div class="mb-4">
                    <label asp-for="Address" class="form-label fw-bold">
                        Address
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-geo-alt-fill text-muted"></i></span>
                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter address"></textarea>
                    </div>
                    <span asp-validation-for="Address" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-3 pt-2">
                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle-fill me-1"></i>Create Profile
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
